# ==============================================================================
# Build & Environment (Maven/Java)
# ==============================================================================
target/
build/
bin/
*.class
*.jar
*.war
*.ear
*.exe
*.dll
*.so
*.dylib
HELP.md
.mvn/wrapper/maven-wrapper.jar

# Keep these even if target is ignored
!**/src/main/**/target/
!**/src/test/**/target/

# ==============================================================================
# Gradle (if used instead of Maven)
# ==============================================================================
.gradle/
gradle/
gradlew
gradlew.bat

# ==============================================================================
# Sensitive Data & Environment Variables (CRITICAL)
# ==============================================================================
.env
.env.local
.env.*.local
*.properties.local
*.yml.local

# Application configuration with secrets
application-local.properties
application-local.yml
application-dev.properties
application-prod.properties
application-staging.yml
application-secret.yml

# Firebase Service Account Keys (NEVER commit!)
**/firebase-*.json
**/serviceAccountKey.json
**/firebase-adminsdk-*.json
src/main/resources/firebase/

# Security & Keys
*.pem
*.key
*.p12
*.jks
*.keystore
*.truststore

# AWS Credentials
.aws/
credentials

