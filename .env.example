# Copy this file to .env and fill in your actual values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitlens
DB_USERNAME=fitlens
DB_PASSWORD=your_database_password_here

# Liquibase Configuration
# Controls which database migrations run based on context
# dev = Run all migrations including mock/test data
# prod = Run only schema migrations (no mock data, won't match 'dev' context)
# none = Run only schema migrations (no mock data, won't match 'dev' context)
LIQUIBASE_CONTEXTS=dev

# Test Database Configuration (for test profile)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=fitlens_test
TEST_DB_USERNAME=fitlens
TEST_DB_PASSWORD=your_test_database_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_at_least_256_bits

# Server Configuration
SERVER_PORT=8080

# API Documentation
API_DOCS_ENABLED=true

# LOGGING
LOG_FILE_PATH=./logs/app.log
ROOT_LOG_LEVEL=info
APP_LOG_LEVEL=debug